    <string name="accessibility_disclosure_no_access_heading">Nosotros NO:</string>
    <string name="accessibility_disclosure_no_access_items">• Recopilar cualquier dato personal o sensible\n• Leer tus mensajes, notificaciones o contraseñas\n• Registre, conserve o comparta el historial de uso de su aplicación</string>
    <string name="accessibility_disclosure_conclusion">Esta función requiere su consentimiento explícito y puede desactivarse fácilmente en cualquier momento en la configuración de su dispositivo.</string>
