<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A browser must still be able to open user-entered HTTP pages and downloads. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
