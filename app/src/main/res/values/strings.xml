    <string name="accessibility_disclosure_intro">This app needs Accessibility Service permission to enable your custom battery and status bar features.</string>
    <string name="accessibility_disclosure_use_heading">The Accessibility Service is used to:</string>
    <string name="accessibility_disclosure_use_items">• Identify and align system UI elements (like the status bar)\n• Properly display custom battery icons and visual overlays on your screen\n• Check the foreground app package locally to hide the overlay in apps you select</string>
    <string name="accessibility_disclosure_visual_only">This permission is strictly used for visual customization only.</string>
    <string name="accessibility_disclosure_no_access_heading">We DO NOT:</string>
    <string name="accessibility_disclosure_no_access_items">• Collect any personal or sensitive data\n• Read your messages, notifications, or passwords\n• Record, retain, or share your app usage history</string>
    <string name="accessibility_disclosure_conclusion">This feature requires your explicit consent and can be easily disabled anytime in your device settings.</string>
