<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/colors_161718"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/img_background_splash"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.28" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/ivLogo"
        android:layout_width="@dimen/_213sdp"
        android:layout_height="@dimen/_94sdp"
        app:lottie_autoPlay="true"
        app:lottie_rawRes="@raw/anim_welcomeback"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_speed="5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/glTop"/>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:fontFamily="@font/montserrat_bold"
        android:textStyle="italic"
        android:gravity="center"
        android:text="@string/welcome_back"
        android:textAllCaps="true"
        android:textColor="@color/colors_FFFFFF"
        android:textSize="@dimen/_20ssp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />
</androidx.constraintlayout.widget.ConstraintLayout>
